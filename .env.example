# Puerto del Servidor
PORT=3000
NODE_ENV=development

# Gemini API Key (Consíguela gratis en https://ai.google.dev/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Credenciales de Firebase Admin SDK (Ruta al archivo JSON descargado de Firebase Console)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Twilio WhatsApp API (Para Sandbox / Producción)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Verificación de Webhook (para Meta API, opcional)
WEBHOOK_VERIFY_TOKEN=synapse_verificacion_2026
