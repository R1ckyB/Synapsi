rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function esAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function esProfesor() {
      return request.auth != null &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['profesor', 'admin'];
    }
    function perteneceAGrupo(grupoId) {
      let grupo = get(/databases/$(database)/documents/grupos/$(grupoId));
      return grupo.data.profesorId == request.auth.uid ||
             request.auth.uid in grupo.data.alumnos;
    }
    function esDuenoGrupo(grupoId) {
      let grupo = get(/databases/$(database)/documents/grupos/$(grupoId));
      return grupo.data.profesorId == request.auth.uid || esAdmin();
    }
    // Campos que nunca puede modificar el cliente directamente
    function noCambiaCamposAdmin() {
      return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['rol', 'uid', 'grupoId', 'grupos', 'profesorId', 'diagnosticoHecho']);
    }

    // ── Perfiles de usuario ───────────────────────────────────────
    match /usuarios/{uid} {
      // Cualquier usuario lee su propio perfil
      allow read: if request.auth != null && request.auth.uid == uid;
      // Los profesores y admins pueden leer perfiles de estudiantes
      allow read: if esProfesor();

      // Crear perfil propio (primer registro)
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['rol', 'grupos', 'profesorId']);

      // Editar perfil propio: NUNCA puede cambiar rol, uid, grupoId ni campos admin
      allow update: if request.auth != null && request.auth.uid == uid
                    && noCambiaCamposAdmin();
    }

    // ── Grupos ────────────────────────────────────────────────────
    match /grupos/{grupoId} {
      allow read: if request.auth != null && (
        resource.data.profesorId == request.auth.uid ||
        request.auth.uid in resource.data.alumnos ||
        esAdmin()
      );
      allow create: if request.auth != null && (
        request.resource.data.profesorId == request.auth.uid || esAdmin()
      );
      allow update, delete: if request.auth != null && (
        resource.data.profesorId == request.auth.uid || esAdmin()
      );
    }

    // ── Anuncios ──────────────────────────────────────────────────
    match /anuncios/{anuncioId} {
      // Solo miembros del grupo pueden leer anuncios de ese grupo
      allow read: if request.auth != null &&
                     perteneceAGrupo(resource.data.grupoId);

      // Crear: el profesor debe ser dueño del grupo en el que publica
      allow create: if esProfesor() &&
                       esDuenoGrupo(request.resource.data.grupoId);

      // Editar o borrar: solo el autor original (profesorId guardado en el doc)
      allow update, delete: if esProfesor() &&
                               resource.data.profesorId == request.auth.uid;
    }

    // ── Quizzes Asignados ─────────────────────────────────────────
    match /quizzesAsignados/{quizId} {
      // Leer: solo miembros del grupo
      allow read: if request.auth != null &&
                     perteneceAGrupo(resource.data.grupoId);

      // Crear: el profesor debe ser dueño del grupo destino
      allow create: if esProfesor() &&
                       esDuenoGrupo(request.resource.data.grupoId);

      // Editar o borrar: solo el profesor que lo creó
      allow update, delete: if esProfesor() &&
                               resource.data.profesorId == request.auth.uid;
    }

    // ── Interacciones de Tutoría ──────────────────────────────────
    match /interacciones/{interaccionId} {
      allow create: if request.auth != null &&
                       request.resource.data.estudianteId == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
                                     resource.data.estudianteId == request.auth.uid;
      // Los profesores pueden leer interacciones de sus alumnos
      allow read: if esProfesor();
    }

    // ── Vacíos de conocimiento ────────────────────────────────────
    // El backend usa Admin SDK y NO necesita permiso de reglas.
    // Denegar escritura directa del cliente para evitar falsificaciones.
    match /vacios_conocimiento/{vacioId} {
      allow read: if request.auth != null && (
        resource.data.estudianteId == request.auth.uid || esProfesor()
      );
      // allow write: DENEGADO — solo el servidor escribe con Admin SDK
    }

    // ── Sesiones de Tutoría ───────────────────────────────────────
    match /sesiones_tutoria/{sesionId} {
      allow create: if request.auth != null &&
                       request.resource.data.estudianteId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.estudianteId == request.auth.uid || esProfesor()
      );
    }
  }
}
